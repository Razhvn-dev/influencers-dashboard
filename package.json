{
  "name": "influencer-dashboard",
  "version": "1.0.0",
  "description": "Shopify Influencer Dashboard CRM backend",
  "main": "server.js",
  "scripts": {
    "build": "npm run build --prefix client",
    "start": "node server.js",
    "migrate": "node scripts/run-migrations.mjs",
    "test:server-port": "node --test tests/server-port.test.js",
    "test:db": "node db.js",
    "build:client": "npm run build --prefix client",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "node server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "preview": "npm run build && npm start",
    "seed:demo": "node scripts/seed-demo-data.js --clear",
    "seed:demo:append": "node scripts/seed-demo-data.js",
    "seed:filter-test": "node scripts/seed-filter-test-data.js --clear",
    "seed:filter-test:append": "node scripts/seed-filter-test-data.js",
    "import:onboarding": "node scripts/import-onboarding-influencers.js --skip-existing",
    "import:onboarding:dry-run": "node scripts/import-onboarding-influencers.js --skip-existing --dry-run",
    "benchmark:api": "node scripts/benchmark-api.mjs",
    "test:smoke-api": "node scripts/smoke-test-api.mjs"
  },
  "dependencies": {
    "@shopify/shopify-api": "^12.3.0",
    "@shopify/shopify-app-express": "^6.0.5",
    "@shopify/shopify-app-session-storage-postgresql": "^5.0.5",
    "compression": "^1.8.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
